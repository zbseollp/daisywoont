---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import bodyHtml from '../../data/elementor/over-ons-body.html?raw';

const stylesheets = [
  '/styles/elementor/epilogue.css',
  '/styles/elementor/poppins.css',
  '/styles/elementor/frontend.min.css',
  '/styles/elementor/widget-image.min.css',
  '/styles/elementor/widget-heading.min.css',
  '/styles/elementor/widget-text-editor.min.css',
  '/styles/elementor/post-335.css',
  '/styles/elementor/post-645.css',
];
---

<Layout
  title="Over ons | DaisyWoont.nl"
  description="Leer het team van DaisyWoont.nl kennen. Wij delen woontips, productreviews en inspiratie voor jouw interieur."
  bodyClass="elementor-kit-335 elementor-page elementor-page-645"
  stylesheets={stylesheets}
>
  <Header />
  <main id="main" class="over-ons-page">
    <PageHero
      title="Over ons"
      paragraphs={[
        'Wij van DaisyWoont.nl bestaan uit een team van bloggers die zich bezighouden met al dat met de inrichting van je huis te maken heeft. Zo doen wij onderzoek naar leuke producten voor in huis, kiezen wij de beste daar van uit en schrijven we interessant blogs.',
      ]}
      imageAlt="Team van DaisyWoont.nl"
    />

    <div class="elementor elementor-645 over-ons-body">
      <div class="elementor-bc-flex-widget" set:html={bodyHtml} />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .over-ons-page {
    width: 100%;
    max-width: none;
    padding: 0;
    margin: 0;
  }

  .over-ons-body :global(img) {
    height: auto;
    max-width: 100%;
  }
</style>
