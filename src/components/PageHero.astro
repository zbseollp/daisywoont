---
interface Props {
  title: string;
  paragraphs: string[];
  imageAlt?: string;
}

const {
  title,
  paragraphs,
  imageAlt = 'DaisyWoont.nl team',
} = Astro.props;
---

<section class="page-hero" aria-labelledby="page-hero-title">
  <div class="page-hero__media" aria-hidden="true">
    <img
      class="page-hero__bg"
      src="/images/Group-95.jpg"
      alt=""
      width="1920"
      height="800"
      loading="eager"
      fetchpriority="high"
    />
    <div class="page-hero__shade"></div>
  </div>

  <div class="page-hero__inner">
    <div class="page-hero__copy">
      <h1 id="page-hero-title">{title}</h1>
      {paragraphs.map((text) => <p>{text}</p>)}
    </div>

    <div class="page-hero__portrait">
      <img
        src="/images/hero-woman-waist-2.png"
        alt={imageAlt}
        width="455"
        height="513"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(320px, 52vw, 460px);
    color: #fff;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center left;
  }

  .page-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.72) 36%,
      rgba(0, 0, 0, 0.35) 58%,
      rgba(0, 0, 0, 0.12) 78%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 1140px);
    margin-inline: auto;
    display: grid;
    gap: 1.5rem;
    align-items: end;
    min-height: inherit;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .page-hero__copy {
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    max-width: 34rem;
  }

  .page-hero__copy h1 {
    margin: 0 0 1rem;
    color: #fff;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .page-hero__copy p {
    margin: 0 0 0.85rem;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.65;
  }

  .page-hero__copy p:last-child {
    margin-bottom: 0;
  }

  .page-hero__portrait {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .page-hero__portrait img {
    width: min(100%, 340px);
    height: auto;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.35));
  }

  @media (min-width: 768px) {
    .page-hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: end;
      gap: 1rem;
    }

    .page-hero__portrait {
      justify-content: flex-end;
    }

    .page-hero__portrait img {
      width: min(100%, 420px);
    }
  }

  @media (max-width: 767px) {
    .page-hero__bg {
      object-position: 70% center;
    }

    .page-hero__shade {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.82) 0%,
        rgba(0, 0, 0, 0.55) 45%,
        rgba(0, 0, 0, 0.25) 100%
      );
    }
  }
</style>
